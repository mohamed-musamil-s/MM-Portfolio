# Template for .env.production (LOCAL production build: `npm run build`, `npm start`,
# `npm run seed:screens:prod`).
#   cp .env.production.example .env.production   # then fill in the values
# The real file is gitignored. Never commit real values. Vercel does not read it:
# Production (go-live branch) variables are set in Vercel > Settings > Environment Variables > Production.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# A separate database from development.
MONGODB_DB=mm-portfolio-prod

ADMIN_EMAIL=
# Use a long access code (16+ characters) in production.
ADMIN_ACCESS_CODE=

# Its own secret, different from development: openssl rand -base64 48
SESSION_SECRET=

LOG_LEVEL=info

# Optional: other sites allowed to READ public GET APIs (comma-separated origins).
# Leave empty: the site itself never needs CORS. Writes are always same-origin only.
CORS_ALLOWED_ORIGINS=
