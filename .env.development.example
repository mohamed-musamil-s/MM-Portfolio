# Template for .env.development (LOCAL development: `npm run dev`, `npm run seed:screens`).
#   cp .env.development.example .env.development   # then fill in the values
# The real file is gitignored. Never commit real values. Vercel does not read it:
# Preview (develop branch) variables are set in Vercel > Settings > Environment Variables > Preview.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mm-portfolio

ADMIN_EMAIL=
# 4+ characters locally; use a long one for Preview and Production.
ADMIN_ACCESS_CODE=

# Generate with: openssl rand -base64 48
SESSION_SECRET=

LOG_LEVEL=debug

# Optional: other sites allowed to READ public GET APIs (comma-separated origins).
# Leave empty: the site itself never needs CORS. Writes are always same-origin only.
CORS_ALLOWED_ORIGINS=
